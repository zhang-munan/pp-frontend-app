	font-size: 14px;
	font-style: italic;
	color: #499771;
	white-space: pre-line;
	position: relative;
	z-index: 1;
	display: block;
	transform: rotate(-7deg);
	padding-top: 10px;
}
.calendar-art image {
	position: absolute;
	bottom: -10px;
	right: -15px;
	width: 135px;
	height: 95px;
	opacity: 0.75;
}
