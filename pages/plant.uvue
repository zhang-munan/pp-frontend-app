	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10px;
	background: #fff4dc;
	border-radius: 14px;
	padding: 8px 13px;
	margin-bottom: 10px;
	min-height: 51px;
	color: #303831;
	font-size: 14px;
}
.sum-number {
	color: #ed9b23;
	font-size: 24px;
}
.water-summary button {
	font-size: 12px;
	gap: 6px;
}
.plant-card {
	padding: 8px;
	gap: 12px;
	min-height: 109px;
	margin-bottom: 10px;
}
.plant-image {
	width: 108px;
	height: 94px;
	border-radius: 11px;
}
.plant-card .m-name {
	font-size: 18px;
}
.plant-card .m-sub {
	margin-top: 3px;
}
.plant-status {
	font-size: 14px;
	margin-top: 7px;
	color: #858b88;
}
.plant-status.m-red {
	color: #e74c4c;
}
.plant-status.m-amber {
	color: #ed9720;
}
.water-action {
	flex-direction: column;
	gap: 5px;
	min-width: 62px;
}
.water-circle {
	width: 36px;
	height: 36px;
	border-radius: 50%;
	background: #ffae2f;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
.water-action text {
	padding: 3px 9px;
	border-radius: 20px;
	background: #fff3d9;
	color: #ed9720;
	font-size: 11px;
}
.water-circle.later {
	background: #4bae7e;
}
.water-action text.later {
	background: #edf7ee;
	color: #329e6b;
}
.guide-banner {
	width: 100%;
	text-align: left;
	padding: 13px 12px;
	gap: 10px;
}
