<template>
	<MPage title="我的">
		<view class="m-card profile-card"
			><button
				class="m-row m-plain profile-top"
				@tap="guest ? login() : open('profile')"
			>
				<image
					class="m-avatar"
					:src="user.info.value?.avatarUrl || asset('profile-avatar.jpg')"
					mode="aspectFill"
				/><view class="m-grow"
					><view class="profile-name"
						>{{ guest ? "点击登录" : user.info.value?.nickName || "我的小天地" }}
						<MIcon name="leaf" :size="20" /></view
					><view class="m-sub">和毛孩子，一起过更温柔的日常</view></view
				></button
			><view class="profile-stats"
				><view
					><text class="m-sub">陪伴</text
					><view
						><text class="stat">{{ guest || !info ? "—" : info.companionDays }}</text
						><text class="stat-unit"> 天</text></view
					></view
				><view
					><text class="m-sub">小伙伴</text
					><view class="stat">{{ guest ? "—" : info ? info.petCount + info.plantCount : pets.length + plants.length }}</view></view
				><view
					><text class="m-sub">记录</text
					><view class="stat">{{ guest || !info ? "—" : info.recordCount }}</view></view
				></view
			></view
		>
		<button class="plus-card m-plain" @tap="guest ? login() : open('membership')">
			<MIcon name="crown" color="amber" :size="38" /><view class="m-grow"
				><view class="m-name">毛与叶 <text class="plus-word">Plus</text></view
				><view class="plus-sub">{{ plusText }}</view></view
			><text v-if="member?.isPlus" class="plus-badge">已开通</text
			><MIcon name="chevron" color="muted" :size="20" />
		</button>
		<view class="m-card menu"
			><button
				v-for="m in firstMenus"
				:key="m.name"
				class="m-plain m-menu-row"
				@tap="open(m.path, m.query || '')"
			>
				<MIcon :name="m.icon" :size="23" /><text>{{ m.name }}</text
				><MIcon name="chevron" color="muted" :size="16" /></button
		></view>
		<view class="m-card menu"
			><button
				v-for="m in secondMenus"
				:key="m.name"
				class="m-plain m-menu-row"
				@tap="open(m.path, m.query || '')"
			>
				<MIcon :name="m.icon" :size="23" /><text>{{ m.name }}</text
				><MIcon name="chevron" color="muted" :size="16" /></button
		></view>
		<view class="m-footer-art"
			><image :src="asset('cat-leaves.png')" mode="aspectFit" /><text
				>以温柔之名\n陪伴更好的生活</text
			></view
		><MTabbar :active="3" />
	</MPage>
</template>
<script setup lang="ts">
import { ref, computed } from "vue";
import MPage from "@/components/MPage.uvue";
import MIcon from "@/components/MIcon.uvue";
import MTabbar from "@/components/MTabbar.uvue";
import { stats, type CareStats } from "@/api/care";
import { memberStatus, type MemberStatus } from "@/api/order";
import { currentTheme, setTheme } from "@/utils/theme";
import { useMaoyu, asset, open, login } from "@/composables/maoyu";
const { guest, user, pets, plants, refresh } = useMaoyu(),
	info = ref<CareStats | null>(null),
	member = ref<MemberStatus | null>(null);
const plusText = computed(() => {
	const m = member.value;
	if (!m?.isPlus) return "让陪伴多一点从容";
	if (m.isLifetime) return "终身会员 · 感谢一路同行";
	return m.expireTime ? `有效期至 ${m.expireTime.slice(0, 10)}` : "会员权益生效中";
});
const firstMenus = [
	{ name: "我的档案", icon: "user", path: "archives" },
	{ name: "家庭共享", icon: "group", path: "family" },
	{ name: "消息设置", icon: "bell", path: "account-settings", query: "section=notifications" },
	{ name: "年度报告", icon: "file", path: "annual-report" },
	{ name: "皮肤与徽章", icon: "crown", path: "badges" }
];
const secondMenus = [
	{ name: "数据导出", icon: "chart", path: "data-export" },
	{ name: "帮助反馈", icon: "help", path: "help" },
	{ name: "设置", icon: "settings", path: "account-settings" }
];
onShow(async () => {
	await refresh();
	if (guest.value) {
		info.value = null;
		member.value = null;
		return;
	}
	const [s, m] = await Promise.all([stats().catch(() => null), memberStatus().catch(() => null)]);
	info.value = s;
	member.value = m;
	if (m && !m.isPlus && currentTheme() !== "leaf") setTheme("leaf");
});
</script>
<style scoped>
.profile-card {
	padding: 16px 16px 12px;
}
.profile-top {
	width: 100%;
	text-align: left;
	justify-content: flex-start;
}
.profile-top .m-avatar {
	width: 70px;
	height: 70px;
}
.profile-name {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
	font-size: 20px;
	font-weight: 650;
	margin-bottom: 8px;
}
.profile-top .m-sub {
	font-size: 11px;
}
.profile-stats {
	display: flex;
	flex-direction: row;
	text-align: center;
	border-top: 1px solid #eef0ea;
	margin-top: 16px;
	padding-top: 13px;
}
.profile-stats > view {
	flex: 1;
	border-right: 1px solid #edf0ea;
}
.profile-stats > view:last-child {
	border: 0;
}
.stat {
	font-size: 27px;
	font-weight: 650;
	color: #28a070;
	line-height: 1.5;
}
.plus-card {
	width: 100%;
	border-radius: 14px;
	background: #fff5da;
	gap: 16px;
	padding: 13px 18px;
	text-align: left;
	margin-bottom: 12px;
	min-height: 64px;
}
.plus-card .m-name {
	font-size: 18px;
}
.plus-word {
	color: #bd941f;
}
.plus-sub {
	font-size: 12px;
	color: #b29459;
}
.plus-badge {
	font-size: 11px;
	color: #9a7413;
	background: #fbe7b0;
	border-radius: 10px;
	padding: 2px 8px;
}
.menu {
	padding: 0 16px;
}
.menu .m-menu-row {
	min-height: 48px;
}
.menu .m-menu-row text {
	font-size: 16px;
}
.m-footer-art {
	margin-top: 17px;
}
.m-footer-art text {
	white-space: pre-line;
	font-size: 13px;
	line-height: 1.8;
}
.stat-unit {
	display: inline;
	font-size: 12px;
	color: #888d90;
}
</style>
