	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8px;
	font-size: 20px;
	font-weight: 650;
	margin-bottom: 8px;
}
.profile-top .m-sub {
	font-size: 11px;
}
.profile-stats {
	display: flex;
	flex-direction: row;
	text-align: center;
	border-top: 1px solid #eef0ea;
	margin-top: 16px;
	padding-top: 13px;
}
.profile-stats > view {
	flex: 1;
	border-right: 1px solid #edf0ea;
}
.profile-stats > view:last-child {
	border: 0;
}
.stat {
	font-size: 27px;
	font-weight: 650;
	color: #28a070;
	line-height: 1.5;
}
.plus-card {
	width: 100%;
	border-radius: 14px;
	background: #fff5da;
	gap: 16px;
	padding: 13px 18px;
	text-align: left;
	margin-bottom: 12px;
	min-height: 64px;
}
.plus-card .m-name {
	font-size: 18px;
}
.plus-word {
	color: #bd941f;
}
.plus-sub {
	font-size: 12px;
	color: #b29459;
}
.menu {
	padding: 0 16px;
}
.menu .m-menu-row {
	min-height: 48px;
}
.menu .m-menu-row text {
	font-size: 16px;
}
.m-footer-art {
	margin-top: 17px;
}
.m-footer-art text {
	white-space: pre-line;
	font-size: 13px;
	line-height: 1.8;
}
.stat-unit {
	display: inline;
	font-size: 12px;
	color: #888d90;
}
</style>
