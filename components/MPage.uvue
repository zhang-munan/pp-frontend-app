<template>
	<view class="m-page" :style="{ '--head-height': headHeight + 'px' }"
		><view class="m-header" :class="{ secondary: back }"
			><button v-if="back" class="m-back m-plain" aria-label="返回" @tap="goBack">
				<MIcon name="back" color="muted" :size="25" /></button
			><text class="m-title">{{ title }}</text></view
		><slot
	/></view>
</template>
<script setup lang="ts">
import MIcon from "./MIcon.uvue";
withDefaults(defineProps<{ title: string; back?: boolean }>(), { back: false });
let headHeight = 100;
// Mini program capsule and device safe area determine the header reservation.
const info = uni.getSystemInfoSync();
headHeight = Math.max(100, (info.statusBarHeight || 0) + 64);
// #ifdef MP-WEIXIN
const capsule = uni.getMenuButtonBoundingClientRect();
headHeight = Math.max(headHeight, capsule.bottom + 20);
// #endif
function goBack() {
	if (getCurrentPages().length > 1) uni.navigateBack();
	else uni.switchTab({ url: "/pages/index" });
}
</script>
