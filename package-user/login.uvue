	opacity: 1;
}
.login-wechat-icon {
	width: calc(58 * var(--login-unit));
	height: calc(50 * var(--login-unit));
}
.login-wechat-label {
	font-size: calc(36 * var(--login-unit));
	font-weight: 600;
	line-height: 1.4;
	color: #fff;
}
.login-browse {
	top: calc(1522 * var(--login-unit));
	height: calc(92 * var(--login-unit));
	border: calc(1.5 * var(--login-unit)) solid #c8c8cb;
	color: #79797d;
	font-size: calc(28 * var(--login-unit));
	letter-spacing: calc(1 * var(--login-unit));
}
.login-footer {
	position: absolute;
