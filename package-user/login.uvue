	position: absolute;
	top: calc(96 * var(--login-unit));
	left: calc(13 * var(--login-unit));
	right: calc(13 * var(--login-unit));
	display: flex;
	flex-direction: row;
}
.login-benefit {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
}
.login-benefit-icon {
	width: calc(108 * var(--login-unit));
	height: calc(108 * var(--login-unit));
	border-radius: 50%;
}
.login-benefit-copy {
	display: block;
	margin-top: calc(15 * var(--login-unit));
	font-size: calc(25 * var(--login-unit));
	line-height: 1.4;
	white-space: pre-line;
	text-align: center;
	font-weight: 400;
}
.login-agreement {
	position: absolute;
	top: calc(1320 * var(--login-unit));
