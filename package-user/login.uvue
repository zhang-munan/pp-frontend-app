<template>
	<view class="login-page" :style="{ '--login-unit': unit + 'px' }">
		<text class="login-title">登录</text>
		<image
			class="login-hero"
			:src="art('hero')"
			mode="scaleToFill"
			aria-label="毛与叶，留住每一次用心照顾。登录后保存档案与记录。猫咪在绿植旁安睡。"
		/>
		<view class="login-benefits">
			<text class="login-benefits-title">登录后你可以</text>
			<view class="login-benefits-grid">
				<view v-for="benefit in benefits" :key="benefit.image" class="login-benefit">
					<image class="login-benefit-icon" :src="art(benefit.image)" mode="aspectFit" />
					<text class="login-benefit-copy">{{ benefit.text }}</text>
				</view>
			</view>
		</view>
		<view class="login-agreement">
			<button
				class="login-check"
				role="checkbox"
				:aria-checked="agreed"
				aria-label="同意用户协议与隐私政策"
				@tap="agreed = !agreed"
			>
				<view class="login-check-circle" :class="{ checked: agreed }"
					><text v-if="agreed">✓</text></view
				>
			</button>
			<text class="login-agreement-copy" @tap="agreed = !agreed">我已阅读并同意</text>
			<button class="login-legal" @tap="open('legal-document', 'type=user_agreement')">
				用户协议
			</button>
			<text class="login-agreement-copy login-and">与</text>
			<button class="login-legal" @tap="open('legal-document', 'type=privacy_policy')">
				隐私政策
			</button>
		</view>
		<button class="login-wechat" :disabled="!agreed || busy" @tap="wechatLogin">
			<image class="login-wechat-icon" :src="asset('login/wechat.svg')" mode="aspectFit" />
			<text class="login-wechat-label">{{ busy ? "正在登录…" : "微信登录" }}</text>
		</button>
		<button class="login-browse" :disabled="busy" @tap="back">暂不登录，继续浏览</button>
		<image
			class="login-footer"
			:src="art('footer')"
			mode="scaleToFill"
			aria-label="和毛孩子，一起遇见更好的生活"
		/>
	</view>
</template>
<script setup lang="ts">
import { ref } from "vue";
import { useStore } from "@/.cool";
import { loginByMiniCode } from "@/api/user";
import { asset, open } from "@/composables/maoyu";
import { errorMessage } from "@/utils/error";
// #ifdef H5
import { wxHelper, ensureWechatMpSilentLogin } from "@/.cool/hooks/wx";
// #endif

const unit = ref(Math.min(uni.getSystemInfoSync().windowWidth, 480) / 852);
const agreed = ref(false),
	busy = ref(false);
// #ifdef H5
const oauthPendingKey = "maoyu_explicit_login_pending";
onLoad(async () => {
	if (!wxHelper.isWxBrowser() || sessionStorage.getItem(oauthPendingKey) !== "1") return;
	sessionStorage.removeItem(oauthPendingKey);
	busy.value = true;
	try {
		if (await ensureWechatMpSilentLogin()) {
			await useStore().user.get();
			back();
		} else {
			uni.showToast({ title: "微信登录未完成，请重试", icon: "none" });
		}
	} finally {
		busy.value = false;
	}
});
// #endif
const benefits = [
	{ image: "benefit-pet", text: "保存毛孩子\n成长档案" },
	{ image: "benefit-plant", text: "记录植物\n养护日记" },
	{ image: "benefit-cloud", text: "多设备同步\n数据不丢失" },
	{ image: "benefit-heart", text: "让美好生活\n一直延续" }
];
const art = (name: string) => asset("login/" + name + ".png");
onResize((event) => {
	unit.value = Math.min(event.size.windowWidth, 480) / 852;
});

async function wechatLogin() {
	if (!agreed.value || busy.value) return;
	// Ordinary browsers keep the existing phone/password login as a secondary flow.
	// #ifdef H5
	if (!wxHelper.isWxBrowser()) {
		uni.showModal({
			title: "请在微信中打开",
			content: "微信登录需要微信环境，也可以继续使用手机号登录。",
			confirmText: "手机号登录",
			cancelText: "取消",
			success: (result) => {
				if (result.confirm) open("login-phone");
			}
		});
		return;
	}
	// #endif
	busy.value = true;
	try {
		// #ifdef MP-WEIXIN
		const code = await new Promise<string>((resolve, reject) => {
			uni.login({
				provider: "weixin",
				success: (result) => {
					if (result.code) resolve(result.code);
					else reject(new Error("未获取到微信登录凭证，请重试"));
				},
				fail: reject
			});
		});
		const token = await loginByMiniCode(code);
		if (!token?.token) throw new Error("微信登录失败，请重试");
		const { user } = useStore();
		user.setToken(token);
		await user.get();
		back();
		// #endif
		// #ifdef H5
		sessionStorage.setItem(oauthPendingKey, "1");
		await wxHelper.mpAuth();
		// #endif
		// #ifndef H5 || MP-WEIXIN
		throw new Error("请在微信中打开后登录");
		// #endif
	} catch (error) {
		// #ifdef H5
		sessionStorage.removeItem(oauthPendingKey);
		// #endif
		uni.showToast({ title: errorMessage(error), icon: "none" });
	} finally {
		busy.value = false;
	}
}
function back() {
	if (getCurrentPages().length > 1) uni.navigateBack();
	else uni.switchTab({ url: "/pages/index" });
}
</script>
<style scoped>
