	align-items: center;
	justify-content: center;
}
.login-check,
.login-legal,
.login-wechat,
.login-browse {
	box-sizing: border-box;
	margin: 0;
	padding: 0;
	border: 0;
	background: transparent;
	line-height: 1.4;
}
.login-check::after,
