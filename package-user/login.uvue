}
.login-check-circle.checked {
	background: #219563;
	border-color: #219563;
}
.login-check-circle text {
	color: #fff;
	font-size: calc(26 * var(--login-unit));
	line-height: 1;
}
.login-agreement-copy,
.login-legal {
	font-size: calc(24 * var(--login-unit));
	font-weight: 400;
