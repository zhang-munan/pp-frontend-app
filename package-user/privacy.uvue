<template>
	<MPage title="隐私与数据" back>
		<view class="m-sub lead">照片用于识别，具体处理方式请查看隐私政策。</view>
		<view class="m-card"
			><button v-for="p in permissions" :key="p.key" class="m-plain m-menu-row perm" @tap="explain(p)">
				<view class="perm-icon"><MIcon :name="p.icon" :size="22" /></view
				><view class="m-grow"
					><view class="m-name">{{ p.name }}</view
					><view class="m-sub">{{ p.desc }}</view></view
				><text class="m-green perm-link">查看说明</text><MIcon name="chevron" color="green" :size="14" /></button
		></view>
		<view class="m-card"
			><button class="m-plain m-menu-row" @tap="open('legal-document', 'type=privacy_policy')">
				<text>隐私政策</text><MIcon name="chevron" color="muted" :size="16" /></button
			><button class="m-plain m-menu-row" @tap="open('legal-document', 'type=user_agreement')">
				<text>用户协议</text><MIcon name="chevron" color="muted" :size="16" /></button
			><button class="m-plain m-menu-row" @tap="exportData">
				<text>导出我的数据</text><MIcon name="chevron" color="muted" :size="16" /></button
		></view>
		<view v-if="!guest" class="m-card danger-card"
			><button class="m-plain m-menu-row" @tap="sheet = true">
				<view class="danger-icon"><MIcon name="close" color="white" :size="16" /></view
				><text class="m-red">删除个人数据</text><MIcon name="chevron" color="muted" :size="16" /></button
		></view>
		<button v-if="!guest" class="m-plain logoff" @tap="confirmLogoff">注销账号</button>
		<view v-if="sheet" class="mask" @tap="sheet = false"
			><view class="sheet" @tap.stop
				><view class="sheet-bar" /><view class="sheet-title">删除个人数据？</view
				><view class="m-sub sheet-sub">将删除全部宠物、植物档案与记录、消息和咨询记录，删除后无法恢复，请先导出需要的记录。账号与会员权益会保留。</view
				><view class="m-row sheet-actions"
					><button class="m-button outline m-grow" @tap="sheet = false">取消</button
					><button class="m-button danger m-grow" :disabled="busy" @tap="purge">
						{{ busy ? "删除中…" : "确认删除" }}
					</button></view
				></view
			></view
		>
	</MPage>
</template>
<script setup lang="ts">
import { ref } from "vue";
import MPage from "@/components/MPage.uvue";
import MIcon from "@/components/MIcon.uvue";
import { purgeData } from "@/api/care";
import { logoff } from "@/api/user";
import { useMaoyu, open, requireLogin } from "@/composables/maoyu";
const { guest, user, refresh } = useMaoyu();
const sheet = ref(false),
	busy = ref(false);
const permissions = [
	{
		key: "camera",
		icon: "camera",
		name: "相机",
		desc: "用于拍摄宠物和植物，进行识别。",
		detail: "仅在你主动拍照建档、记录成长或拍照问诊时调用相机，照片会上传到你的账号用于展示和 AI 识别，不会用于其他用途。"
	},
	{
		key: "album",
		icon: "file",
		name: "相册",
		desc: "用于选择本地照片，进行识别。",
		detail: "仅在你主动选择照片时读取所选图片，不会读取相册中的其他内容。"
	}
];
function explain(p: (typeof permissions)[number]) {
	uni.showModal({
		title: p.name + "权限说明",
		content: p.detail,
		confirmText: "去设置",
		cancelText: "知道了",
		success: (r) => {
			// #ifdef MP-WEIXIN
			if (r.confirm) uni.openSetting({});
			// #endif
		}
	});
}
function exportData() {
	if (!requireLogin()) return;
	open("data-export");
}
async function purge() {
	if (busy.value) return;
	busy.value = true;
	try {
		await purgeData();
		sheet.value = false;
		await refresh();
		uni.showToast({ title: "已删除个人数据" });
	} catch (e) {
		/* The request layer reports the error. */
	} finally {
		busy.value = false;
	}
}
function confirmLogoff() {
	uni.showModal({
		title: "注销账号",
		content: "注销后将删除你的全部档案、记录与会员权益，且无法恢复。订单记录会按法规保留。确定继续？",
		confirmText: "继续",
		confirmColor: "#c95b54",
		success: (r) => {
			if (!r.confirm) return;
			uni.showModal({
				title: "最后确认",
				content: "账号注销后不可找回，确认注销？",
				confirmText: "确认注销",
				confirmColor: "#c95b54",
				success: async (r2) => {
					if (!r2.confirm) return;
					try {
						await logoff();
						user.clear();
						await refresh();
						uni.showToast({ title: "账号已注销" });
						setTimeout(() => uni.switchTab({ url: "/pages/mine" }), 600);
					} catch (e) {
						/* The request layer reports the error. */
					}
				}
			});
		}
	});
}
</script>
<style scoped>
.lead {
	margin: 4px 2px 12px;
}
.perm {
	gap: 12px;
	min-height: 72px;
}
.perm-icon {
	width: 42px;
	height: 42px;
	border-radius: 50%;
	background: #e6f3ec;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}
.m-menu-row .perm-link {
	flex: none;
	font-size: 13px;
	margin-right: -12px;
}
.danger-card .m-menu-row {
	gap: 12px;
}
.danger-card .m-red {
	flex: 1;
}
.danger-icon {
	width: 32px;
	height: 32px;
	border-radius: 50%;
	background: #d86b63;
	display: flex;
	align-items: center;
	justify-content: center;
}
.logoff {
	width: 100%;
	color: #9a9f9b;
	font-size: 13px;
	margin-top: 8px;
}
.mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(0, 0, 0, 0.35);
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	z-index: 50;
}
.sheet {
	background: #fff;
	border-radius: 20px 20px 0 0;
	padding: 10px 20px calc(24px + env(safe-area-inset-bottom));
	text-align: center;
}
.sheet-bar {
	width: 40px;
	height: 4px;
	border-radius: 2px;
	background: #ddd;
	margin: 0 auto 18px;
}
.sheet-title {
	font-size: 20px;
	font-weight: 650;
	margin-bottom: 10px;
}
.sheet-sub {
	line-height: 1.7;
	margin-bottom: 22px;
}
.sheet-actions {
	gap: 12px;
}
.m-button.danger {
	background: #c95b54;
	border-color: #c95b54;
	color: #fff;
}
</style>
