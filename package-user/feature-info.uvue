			}}</view
			><view class="m-sub intro">{{ content.description }}</view
			><button class="m-button full outline" @tap="open('archives')">
				查看我的档案
			</button></view
		></MPage
	>
</template>
<script setup lang="ts">
import { ref, computed } from "vue";
import MPage from "@/components/MPage.uvue";
import { asset, open } from "@/composables/maoyu";
const kind = ref("family");
const data = {
	family: {
		title: "家庭共享",
		heading: "让家人一起见证成长",
		description: "家庭只读共享尚未开放。功能开放后，你可以自主选择要与家人共享的档案。"
