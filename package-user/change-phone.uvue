<script setup lang="ts">
import { computed, onUnmounted, ref } from "vue";
import {
	bindMiniPhone,
	bindPhone,
	getCaptcha,
	getCaptchaImageSrc,
	sendSmsCode
} from "@/api/user";
import { useStore } from "@/.cool";

const { user } = useStore();

const phone = ref("");
const smsCode = ref("");
const loading = ref(false);
const countdown = ref(0);
const showCaptcha = ref(false);
const captchaImg = ref("");
const captchaId = ref("");
const captchaCode = ref("");
const captchaLoading = ref(false);
let countdownTimer: ReturnType<typeof setInterval> | null = null;

const sendBtnText = computed(() =>
	countdown.value > 0 ? `${countdown.value}s 后重发` : "获取验证码"
);

function isValidPhone(value: string) {
	return /^1[3-9]\d{9}$/.test(value);
}

function startCountdown() {
	countdown.value = 60;
	countdownTimer && clearInterval(countdownTimer);
	countdownTimer = setInterval(() => {
		countdown.value -= 1;
		if (countdown.value <= 0 && countdownTimer) clearInterval(countdownTimer);
	}, 1000);
}

async function refreshCaptcha() {
	try {
		captchaLoading.value = true;
		const res = await getCaptcha({ width: 150, height: 50, color: "#fe8973" });
		if (!res) throw new Error("验证码获取失败");
		captchaId.value = res.captchaId;
		captchaImg.value = getCaptchaImageSrc(res.data);
	} finally {
		captchaLoading.value = false;
	}
}

async function onGetSmsCode() {
	if (countdown.value > 0) return;
	if (!isValidPhone(phone.value)) {
		uni.showToast({ title: "请输入正确的手机号", icon: "none" });
		return;
	}
	captchaCode.value = "";
	showCaptcha.value = true;
	await refreshCaptcha();
}

async function confirmCaptcha() {
	if (!captchaCode.value) {
		uni.showToast({ title: "请输入图片验证码", icon: "none" });
		return;
	}
	try {
		await sendSmsCode({
			phone: phone.value,
			captchaId: captchaId.value,
			code: captchaCode.value
		});
		showCaptcha.value = false;
		uni.showToast({ title: "验证码已发送", icon: "none" });
		startCountdown();
	} catch {
		refreshCaptcha();
	}
}

async function finishChange() {
	await user.get();
	uni.showToast({ title: "手机号已换绑", icon: 'none' });
	setTimeout(() => uni.navigateBack(), 600);
}

async function handleSmsChange() {
	if (!isValidPhone(phone.value)) {
		uni.showToast({ title: "请输入正确的手机号", icon: "none" });
		return;
	}
	if (!smsCode.value) {
		uni.showToast({ title: "请输入验证码", icon: "none" });
		return;
	}
	try {
		loading.value = true;
		const token = await bindPhone(phone.value, smsCode.value);
		if (!token) throw new Error("登录信息获取失败");
		user.setToken(token);
		await finishChange();
	} finally {
		loading.value = false;
	}
}

// #ifdef MP-WEIXIN
const loginCode = ref("");

function wxLogin(): Promise<string> {
	return new Promise((resolve, reject) => {
		uni.login({ provider: "weixin", success: (res) => resolve(res.code), fail: reject });
	});
}

async function refreshLoginCode() {
	try {
		loginCode.value = await wxLogin();
	} catch {
		loginCode.value = "";
	}
}

async function handleWxPhone(e: any) {
	if (e?.detail?.errMsg !== "getPhoneNumber:ok") {
		uni.showToast({ title: "已取消微信授权", icon: "none" });
		return;
	}
	try {
		loading.value = true;
		const code = loginCode.value || (await wxLogin());
		const token = await bindMiniPhone({
			code,
			encryptedData: e.detail.encryptedData,
			iv: e.detail.iv
		});
		if (!token) throw new Error("登录信息获取失败");
		user.setToken(token);
		await finishChange();
	} finally {
		loading.value = false;
		refreshLoginCode();
	}
}

onShow(() => refreshLoginCode());
// #endif

onUnmounted(() => {
	if (countdownTimer) clearInterval(countdownTimer);
});
</script>

<template>
	<view class="min-h-[100vh] bg-[#fffaf7] text-[#3a2420]">
		<cl-topbar title="换绑手机号" safeAreaTop fixed backgroundColor="#fffaf7" />

		<scroll-view scroll-y class="h-[calc(100vh-112rpx)]" :show-scrollbar="false">
			<view class="px-[34rpx] pt-[56rpx]">
				<view
					class="flex h-[96rpx] w-[96rpx] items-center justify-center rounded-[30rpx] bg-[#fff0eb]"
				>
					<cl-icon
						name="smartphone-line"
						:size="30"
						:pt="{ className: 'text-[#fe8973]' }"
					/>
				</view>
				<text class="mt-[28rpx] block text-[44rpx] font-[800] leading-[58rpx]"
					>绑定新的手机号</text
				>
				<text class="mt-[12rpx] block text-[26rpx] text-[#9b756a] leading-[38rpx]"
					>换绑后将使用新手机号登录和接收服务通知</text
				>

				<view
					class="mt-[42rpx] rounded-[28rpx] bg-white py-[34rpx] shadow-[0_16rpx_46rpx_#7846301f]"
				>
					<!-- #ifdef MP-WEIXIN -->
					<cl-button
						class="w-full"
						size="large"
						type="success"
						icon="wechat-fill"
						open-type="getPhoneNumber"
						:loading="loading"
						:pt="{
							className: '!h-[86rpx] !rounded-[24rpx] !border-[#55b84e] !bg-[#55b84e]'
						}"
						@getphonenumber="handleWxPhone"
					>
						一键换绑
					</cl-button>
					<view class="mt-[36rpx] flex flex-row items-center">
						<view class="h-[1rpx] flex-1 bg-[#e8d8d0]" />
						<text class="px-[34rpx] text-[24rpx] text-[#9a8077]">或使用验证码</text>
						<view class="h-[1rpx] flex-1 bg-[#e8d8d0]" />
					</view>
					<!-- #endif -->

					<view
						class="mt-[24rpx] h-[78rpx] flex flex-row items-center border-[1px] border-solid border-[#eadbd5] rounded-[16rpx] bg-[#fffdfc] px-[26rpx]"
					>
						<text class="text-[30rpx]">+86</text>
						<view class="mx-[24rpx] h-[34rpx] w-[1rpx] bg-[#eee2de]" />
						<input
							v-model="phone"
							class="h-[70rpx] flex-1 text-[28rpx]"
							placeholder="请输入新的手机号"
							placeholder-class="text-[#b9aaa4]"
							type="number"
							:maxlength="11"
						/>
					</view>

					<view
						class="mt-[22rpx] h-[78rpx] flex flex-row items-center border-[1px] border-solid border-[#eadbd5] rounded-[16rpx] bg-[#fffdfc] px-[26rpx]"
					>
						<input
							v-model="smsCode"
							class="h-[70rpx] flex-1 text-[28rpx]"
							placeholder="请输入验证码"
							placeholder-class="text-[#b9aaa4]"
							type="number"
							:maxlength="6"
						/>
						<cl-button
							size="small"
							type="light"
							border
							color="#fe8973"
							:disabled="countdown > 0"
							:pt="{
								className:
									'!h-[52rpx] min-w-[156rpx] !rounded-[18rpx] !border-[#ffc5bc] !bg-[#fff8f6] px-[16rpx]'
							}"
							@click="onGetSmsCode"
						>
							{{ sendBtnText }}
						</cl-button>
					</view>

					<cl-button
						size="large"
						class="mt-[30rpx]"
						:loading="loading"
						@click="handleSmsChange"
						>确认换绑</cl-button
					>
				</view>
			</view>
		</scroll-view>

		<view
			v-if="showCaptcha"
			class="fixed inset-[0rpx] z-[30] flex flex-row items-center justify-center bg-[#2c1e1947] px-[84rpx]"
		>
			<view
				class="w-full rounded-[22rpx] bg-[#fffefa] px-[36rpx] py-[36rpx] shadow-[0_18rpx_58rpx_#492a2038]"
			>
				<text class="block text-center text-[34rpx] font-[800]">请输入图片验证码</text>
				<view class="mt-[28rpx] flex flex-row items-center gap-[18rpx]">
					<input
						v-model="captchaCode"
						class="h-[80rpx] flex-1 border-[1px] border-[#eadbd5] rounded-[16rpx] px-[24rpx] text-[28rpx]"
						placeholder="图片验证码"
					/>
					<view
						class="h-[80rpx] w-[200rpx] overflow-hidden border-[1px] border-[#eadbd5] rounded-[16rpx]"
						@click="refreshCaptcha"
					>
						<image
							v-if="captchaImg"
							:src="captchaImg"
							mode="aspectFit"
							class="h-full w-full"
						/>
						<text
							v-else
							class="block pt-[22rpx] text-center text-[22rpx] text-[#b9aaa4]"
							>{{ captchaLoading ? "加载中…" : "点击刷新" }}</text
						>
					</view>
				</view>
				<text class="mt-[14rpx] block text-[22rpx] text-[#9a8178]"
					>看不清？点击图片刷新</text
				>
				<view class="mt-[28rpx] flex flex-row gap-[18rpx]">
					<button
						class="h-[72rpx] flex-1 border-[1px] border-[#e3d3cc] rounded-[18rpx] bg-white p-[0rpx] text-[28rpx] leading-[72rpx]"
						@click="showCaptcha = false"
					>
						取消
					</button>
					<button
						class="h-[72rpx] flex-1 border-[0rpx] rounded-[18rpx] bg-[#fe8973] p-[0rpx] text-[28rpx] text-white leading-[72rpx]"
						@click="confirmCaptcha"
					>
						确认发送
					</button>
				</view>
			</view>
		</view>
	</view>
</template>
